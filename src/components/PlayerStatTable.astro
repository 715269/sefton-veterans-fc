---
// src/components/PlayerStatTable.astro
//
// One of the Season statistics tables on a team page — Goalscorers,
// Appearances or Man of the Match — where each player's row opens to show the
// matches behind his number. Tap "Jamie Hay · 5" and you see the games he
// scored in; tap one of those games and the usual match drawer opens with the
// full teamsheet.
//
//   <PlayerStatTable kind="goals" title="Goalscorers" rows={topScorers} />
//
// How the match drawer hooks in: MatchDetail.astro attaches itself to anything
// carrying data-md-row + data-date + data-team + data-opponent. Each match in
// the breakdown carries exactly those, so this component never talks to the
// drawer directly — and the drawer needs no changes to support it.
//
// Every breakdown is rendered into the page at build time and just shown or
// hidden. No fetching, so opening one is instant and works on a poor signal.
//
// Each player gets his own <tbody> (his row + his hidden breakdown row). That
// keeps the zebra striping correct — with one big tbody, the hidden rows would
// still count towards :nth-child and the stripes would come out wrong.

const { kind, title, rows = [] } = Astro.props;

// The number columns for each kind of table.
const COLUMNS = {
  goals: [{ label: 'Goals', value: (p) => p.goals }],
  apps: [
    { label: 'Apps', value: (p) => p.appearances },
    { label: 'Starts', value: (p) => p.starts },
  ],
  motm: [{ label: 'Awards', value: (p) => p.motm }],
};
const columns = COLUMNS[kind] ?? [];

// Which of a player's matches belong in each breakdown.
function matchesFor(p) {
  const all = Array.isArray(p.matches) ? p.matches : [];
  if (kind === 'goals') return all.filter((m) => m.goals > 0);
  if (kind === 'motm') return all.filter((m) => m.motm);
  return all.filter((m) => m.started || m.sub);
}

// The detail line under each match: what kind of fixture it was first (League,
// LCFA Cup, Friendly — whatever the Fixtures tab says), then what the player
// did in it. Appearances also mention any goals or award in that game — it
// costs nothing and answers the obvious follow-up question.
function noteFor(m) {
  const bits = [];
  if (m.type) bits.push(m.type);
  if (kind === 'apps') bits.push(m.started ? 'Started' : 'Sub');
  if (m.goals === 1) bits.push('1 goal');
  else if (m.goals > 1) bits.push(`${m.goals} goals`);
  if (kind === 'apps' && m.motm) bits.push('MotM');
  return bits.join(' \u00b7 ');
}

function readable(raw) {
  const parts = String(raw).split(',');
  if (parts.length !== 2) return String(raw).trim();
  return `${parts[1].trim()} ${parts[0].trim()}`;
}

// "27 Sep" — the year is the season, so it only adds width. Built by hand
// rather than with toLocaleDateString, which gives "Sept" on newer Node
// versions and "Sep" on older ones, depending on what Netlify happens to run.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function shortDate(iso) {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return iso;
  return `${Number(m[3])} ${MONTHS[Number(m[2]) - 1]}`;
}

function venueMark(m) {
  if (m.homeAway === 'Home') return 'H';
  if (m.homeAway === 'Away') return 'A';
  return '';
}

// "3-1" stored → "3–1" shown, with a proper en dash.
function score(m) {
  return String(m.result || '').replace('-', '–');
}

// A stable, unique id per table per player, for aria-controls.
function detailId(p, i) {
  const base = String(p.name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return `ps-${kind}-${base || 'player'}-${i}`;
}

const colspan = 2 + columns.length;
---

<div class="ps-block">
  <h3>{title}</h3>
  <table class="ps-table">
    <thead>
      <tr>
        <th class="ps-narrow">#</th>
        <th>Player</th>
        {columns.map((c) => <th class="ps-narrow ps-num">{c.label}</th>)}
      </tr>
    </thead>

    {rows.map((p, i) => {
      const id = detailId(p, i);
      const list = matchesFor(p);
      return (
        <tbody class="ps-group">
          <tr class="ps-row">
            <td class="ps-narrow ps-pos">{p.joint ? `=${p.rank}` : p.rank}</td>
            <td>
              <button
                type="button"
                class="ps-toggle"
                aria-expanded="false"
                aria-controls={id}
              >
                <span class="ps-name">{readable(p.name)}</span>
                <span class="ps-chev" aria-hidden="true"></span>
              </button>
            </td>
            {columns.map((c) => <td class="ps-narrow ps-num">{c.value(p)}</td>)}
          </tr>
          <tr class="ps-detail" id={id} hidden>
            <td colspan={colspan}>
              {list.length === 0 ? (
                <p class="ps-empty">No match breakdown available.</p>
              ) : (
                <ul class="ps-matches">
                  {list.map((m) => (
                    <li
                      class="ps-match"
                      data-md-row
                      data-date={m.date}
                      data-team={m.team}
                      data-opponent={m.opponent}
                    >
                      <span class="ps-date">{shortDate(m.date)}</span>
                      <span class="ps-opp">
                        {m.opponent}
                        {venueMark(m) && <span class="ps-venue"> ({venueMark(m)})</span>}
                      </span>
                      <span class={`ps-res ps-res-${String(m.outcome).toLowerCase()}`}>
                        {String(m.outcome).charAt(0)} {score(m)}
                      </span>
                      {noteFor(m) && <span class="ps-note">{noteFor(m)}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </td>
          </tr>
        </tbody>
      );
    })}
  </table>
</div>

<script>
  // One delegated listener for every table on the page. Astro bundles this
  // script once however many tables use the component.
  //
  // Clicking anywhere on a player's row toggles it, not just on his name — a
  // bigger target on a phone. The name is a real <button>, so keyboard users
  // get Enter/Space for free and that click bubbles up to here too.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const row = target?.closest?.('.ps-row');
    if (!row) return;

    const button = row.querySelector('.ps-toggle');
    if (!button) return;
    const detail = document.getElementById(button.getAttribute('aria-controls') || '');
    if (!detail) return;

    const opening = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', opening ? 'true' : 'false');
    row.classList.toggle('is-open', opening);
    detail.hidden = !opening;
  });
</script>

<style>
  .ps-block h3 {
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .ps-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin-top: 0.75rem;
    background: white;
  }

  .ps-table thead th {
    background: var(--color-navy, #0f172a);
    color: white;
    text-align: left;
    padding: 0.6rem 0.75rem;
    white-space: nowrap;
    font-family: var(--font-body);
    font-weight: 600;
  }

  .ps-table td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }

  /* Stripe by player, not by row — see the note at the top of the file. */
  .ps-group:nth-of-type(even) .ps-row {
    background: #f8fafc;
  }

  .ps-narrow {
    width: 1%;
    white-space: nowrap;
  }

  .ps-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ps-table thead th.ps-num {
    text-align: right;
  }

  /* ---------- the player row ---------- */

  .ps-row {
    cursor: pointer;
  }

  .ps-row:hover,
  .ps-row.is-open {
    background: #eef2ff !important;
  }

  .ps-toggle {
    all: unset;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    color: var(--color-navy, #0f172a);
    border-radius: 4px;
  }

  .ps-toggle:focus-visible {
    outline: 3px solid var(--color-blue, #2323e0);
    outline-offset: 2px;
  }

  .ps-row:hover .ps-name,
  .ps-row.is-open .ps-name {
    color: var(--color-blue, #2323e0);
  }

  /* A small chevron that turns when open, so it's obvious the row does
     something before anyone taps it. */
  .ps-chev {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid #94a3b8;
    border-bottom: 2px solid #94a3b8;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .ps-toggle[aria-expanded='true'] .ps-chev {
    transform: rotate(45deg);
    border-color: var(--color-blue, #2323e0);
  }

  /* ---------- the breakdown ---------- */

  .ps-detail td {
    background: #f8fafc;
    padding: 0.35rem 0.75rem 0.6rem;
  }

  .ps-matches {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ps-match {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    grid-template-areas:
      'date opp res'
      '.    note note';
    column-gap: 0.6rem;
    row-gap: 0.1rem;
    align-items: baseline;
    padding: 0.5rem 0.5rem;
    border-radius: 6px;
    font-size: 0.88rem;
  }

  .ps-match + .ps-match {
    border-top: 1px dashed #e2e8f0;
  }

  /* MatchDetail marks the line as openable once it finds the match. Only then
     does it get a hover — a line with no report behind it stays flat. */
  .ps-match[data-md-open]:hover {
    background: white;
    box-shadow: 0 0 0 1px #e2e8f0;
  }

  .ps-match[data-md-open]:hover .ps-opp {
    color: var(--color-blue, #2323e0);
  }

  .ps-date {
    grid-area: date;
    color: #64748b;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ps-opp {
    grid-area: opp;
    color: var(--color-navy, #0f172a);
    font-weight: 500;
  }

  .ps-venue {
    color: #94a3b8;
    font-weight: 400;
  }

  .ps-res {
    grid-area: res;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    background: #f1f5f9;
    color: #475569;
  }

  .ps-res-win { background: #dcfce7; color: #166534; }
  .ps-res-draw { background: #fef9c3; color: #854d0e; }
  .ps-res-loss { background: #fee2e2; color: #991b1b; }

  .ps-note {
    grid-area: note;
    color: #64748b;
    font-size: 0.8rem;
  }

  .ps-empty {
    margin: 0.4rem 0;
    color: #64748b;
    font-style: italic;
    font-size: 0.88rem;
  }
</style>
