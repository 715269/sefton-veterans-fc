---
// src/components/TeamTiles.astro
//
// The four team tiles: numeral for identity, manager, and the last five
// results. Used on the home page and on /teams, so the two can never drift
// apart — which is exactly what had happened with the hardcoded cards this
// replaced, still advertising competitions the teams had stopped playing in.

import { TEAMS } from '../lib/teams.js';
import { getSummary, getManagers } from '../lib/season.js';

const managers = await getManagers();

const tiles = await Promise.all(
  TEAMS.map(async (t) => {
    const summary = await getSummary(t.name);

    // Oldest on the left, newest on the right — the same order as the form
    // string on the team pages, so the two can never contradict each other.
    // Padded to five so every tile has the same rhythm in August.
    const form = summary.form.slice(-5);
    const dots = [...form, ...Array(Math.max(0, 5 - form.length)).fill(null)];

    return { ...t, dots };
  })
);

// Names are stored "Surname, Forename". Right for sorting, wrong for reading.
function readable(raw) {
  const parts = String(raw).split(',');
  if (parts.length !== 2) return String(raw).trim();
  return `${parts[1].trim()} ${parts[0].trim()}`;
}

function managerLine(team) {
  const list = (managers[team] ?? []).map(readable);
  if (list.length === 0) return null;
  if (list.length === 1) return { label: 'Manager', names: list[0] };
  return { label: 'Managers', names: list.join(' & ') };
}

const OUTCOME_WORD = { W: 'won', D: 'drew', L: 'lost' };

function formSentence(dots) {
  const played = dots.filter(Boolean);
  if (played.length === 0) return 'No matches played yet this season.';
  return 'Recent form, oldest first: ' +
    played.map((d) => OUTCOME_WORD[d] ?? d).join(', ') + '.';
}
---

<div class="tile-grid">
  {tiles.map((team) => {
    const mgr = managerLine(team.name);
    return (
      <a class="tile" href={`/teams/${team.slug}`}>
        <span class="stripes" aria-hidden="true"></span>
        <span class="glow" aria-hidden="true"></span>
        <span class="numeral" aria-hidden="true">
          {team.slug === 'open-age' ? 'OA' : team.name.replace(/\D/g, '')}
        </span>

        <span class="head">
          <span class="name">{team.name}</span>
          <span class="comp">{team.comp}</span>
        </span>

        <span class="foot">
          {mgr && (
            <span class="mgr">
              <span class="mgr-label">{mgr.label}</span>
              <span class="mgr-name">{mgr.names}</span>
            </span>
          )}

          <span class="form" role="img" aria-label={formSentence(team.dots)}>
            {team.dots.map((d) => (
              <span class={`dot ${d ? d.toLowerCase() : 'none'}`} aria-hidden="true">
                {d ?? ''}
              </span>
            ))}
          </span>
        </span>
      </a>
    );
  })}
</div>

<style>
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    background: var(--color-navy);
    border-radius: 12px;
    padding: 1.1rem 1rem 0.95rem;
    aspect-ratio: 4 / 4.6;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.22);
  }

  .tile:focus-visible {
    outline: 3px solid var(--color-blue);
    outline-offset: 3px;
  }

  /* A nod to a striped shirt, not a reproduction of one — the teams don't all
     play in the same kit, so anything more literal would be wrong for three
     of the four. */
  .stripes {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: repeating-linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.035) 0 20px,
      rgba(255, 255, 255, 0) 20px 40px
    );
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(
      130% 80% at 78% 8%,
      rgba(35, 35, 224, 0.42) 0%,
      rgba(35, 35, 224, 0) 60%
    );
  }

  /* Ghosted so the words stay first. The numeral is identity, not headline. */
  .numeral {
    position: absolute;
    right: -0.08em;
    bottom: -0.3em;
    z-index: -1;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 8rem;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.17);
    pointer-events: none;
  }

  /* "OA" is two letters where the others are two digits, so it needs pulling
     back or it crowds the tile. */
  .tile[href$='open-age'] .numeral {
    font-size: 5.4rem;
    right: 0.01em;
    bottom: -0.18em;
  }

  .head { display: block; }

  .name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: white;
    letter-spacing: -0.01em;
  }

  .comp {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.74rem;
    color: #94a3b8;
  }

  .foot { display: block; }

  .mgr {
    display: block;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .mgr-label {
    display: block;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
  }

  .mgr-name {
    display: block;
    font-size: 0.78rem;
    color: #cbd5e1;
  }

  .form {
    display: flex;
    gap: 0.22rem;
  }

  .dot {
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 700;
  }

  .dot.w { background: #22c55e; color: #052e16; }
  .dot.d { background: #eab308; color: #422006; }
  .dot.l { background: #ef4444; color: #450a0a; }

  /* Dashed rather than filled grey: "not played yet" reads as a gap waiting
     to be filled, where a grey disc reads as something broken. */
  .dot.none {
    background: transparent;
    border: 1px dashed rgba(255, 255, 255, 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile { transition: none; }
  }
</style>
