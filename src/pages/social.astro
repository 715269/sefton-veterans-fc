---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import agmGame from '../assets/agm-game-2024.jpg';
import squad2022 from '../assets/squad-2022.jpg';
---

<BaseLayout title="Social">
  <section class="hero-band">
    <div class="container">
      <h1>Social</h1>
      <p>Club events, photos, and how to get involved.</p>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Club Life</h2>
    <div class="photo-grid">
      <Image src={agmGame} alt="Sefton Veterans FC social event" width={700} />
      <Image src={squad2022} alt="Sefton Veterans FC players" width={700} />
    </div>
    <p><em>Placeholder — add upcoming social events and news here.</em></p>
  </section>

  <section class="section-navy section-padded">
    <div class="container">
      <h2>Player Registration</h2>
      <p>
        Placeholder — the player registration form needs to be rebuilt here.
        Since Astro pages are static by default, this form will need a way
        to actually receive submissions (e.g. a form service like Formspree,
        or a small serverless function). Let's tackle that as its own step.
      </p>
      <a href="/social" class="btn btn-outline">Coming soon</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .photo-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
  }
</style>
