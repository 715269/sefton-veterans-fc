---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import MatchdayStrip from '../components/MatchdayStrip.astro';
import SeasonRankings from '../components/SeasonRankings.astro';
import heroPitch from '../assets/hero-pitch.jpg';
import clubBadge from '../assets/club-badge.png';
import agmGame from '../assets/agm-game-2024.jpg';
import squad2022 from '../assets/squad-2022.jpg';
import squad2023 from '../assets/squad-2023.jpg';
---

<BaseLayout title="Home">
  <section class="hero full-bleed">
    <Image src={heroPitch} alt="" class="hero-image" width={1019} priority />
    <div class="hero-overlay">
      <div class="container hero-content">
        <h1>Welcome to Sefton Veterans FC</h1>
        <p>
          Competitive, friendly football for Over 35s, Over 45s, Over 50s,
          and Open Age players across Sefton, Merseyside.
        </p>
        <div class="hero-buttons">
          <a href="/fixtures" class="btn btn-primary">Fixtures &amp; Results</a>
          <a href="/about" class="btn btn-outline">About the Club</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padded container">
    <MatchdayStrip />
  </section>

  <section class="section-light section-padded">
    <div class="container">
      <SeasonRankings />
    </div>
  </section>

  <section class="section-padded container">
    <h2>About Us</h2>
    <div class="about-grid">
      <div>
        <p>
          Sefton Veterans Football Club was founded in 2011. The club has
          grown into a strong and stable multi-cup winning organisation,
          attracting the best players from around Merseyside — providing
          they fit with the club's ethos and high standards, on and off
          the pitch.
        </p>
        <a href="/about" class="btn btn-primary">More about the club →</a>
      </div>
      <Image
        src={clubBadge}
        alt="Sefton Veterans FC club badge"
        width={240}
        class="about-badge"
      />
    </div>
  </section>

  <section class="section-navy section-padded">
    <div class="container">
      <h2>Our Teams</h2>
      <div class="card-grid">
        <a href="/teams/over-35s" class="card team-card">
          <div class="card-body">
            <h3>Over 35s</h3>
            <p>Competing in the Cheshire &amp; Wirral Football League Premier Division.</p>
          </div>
        </a>
        <a href="/teams/over-45s" class="card team-card">
          <div class="card-body">
            <h3>Over 45s</h3>
            <p>Friendly and cup football across Merseyside, Wirral and Cheshire.</p>
          </div>
        </a>
        <a href="/teams/over-50s" class="card team-card">
          <div class="card-body">
            <h3>Over 50s</h3>
            <p>Legends Cup and friendly fixtures for our most experienced squad.</p>
          </div>
        </a>
        <a href="/teams/open-age" class="card team-card">
          <div class="card-body">
            <h3>Open Age</h3>
            <p>Playing as Sefton OA FC since the 2023/24 season.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Club Life</h2>
    <div class="photo-grid">
      <Image src={agmGame} alt="Sefton Veterans FC match action" width={700} />
      <Image src={squad2022} alt="Sefton Veterans FC players" width={700} />
      <Image src={squad2023} alt="Sefton Veterans FC on the pitch" width={700} />
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero photo is a real <img> sitting behind the overlay, rather than a
     CSS background. The browser can start fetching it as soon as it reads the
     markup, and Astro can convert it to WebP and generate a srcset — neither of
     which is possible with background-image. */
  .hero {
    position: relative;
    isolation: isolate;
  }

  /* The source photo is roughly 1.7:1, but a full-bleed band on a wide monitor
     is far wider than that, so cover() has to overflow it vertically and trim.
     The players' faces sit high in the frame, so the crop is biased upward
     rather than centred — otherwise heads get cut off on desktop. */
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    z-index: -1;
  }

  .hero-overlay {
    background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.6));
    padding: 5rem 0;
  }

  /* A taller band on big screens means less vertical overflow, so less of the
     photo is thrown away. */
  @media (min-width: 1100px) {
    .hero-overlay {
      padding: 7.5rem 0;
    }
  }

  .hero-content {
    max-width: 700px;
  }

  .hero-content h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero-content p {
    color: #e2e8f0;
    font-size: 1.15rem;
    margin-bottom: 1.75rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* "auto" rather than "1fr" for the badge column: the column is now only as
     wide as the badge, so the badge no longer sits marooned in white space.
     The badge file is only 240px wide, so it can't be enlarged much without
     going soft — shrinking the gap around it is the better lever. */
  .about-grid {
    display: grid;
    grid-template-columns: 2fr auto;
    gap: 3rem;
    align-items: center;
  }

  .about-badge {
    width: 260px;
    max-width: 100%;
    height: auto;
    justify-self: center;
  }

  .team-card {
    background: white;
  }

  .team-card .card-body h3 {
    color: var(--color-navy);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .photo-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
  }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-content h1 {
      font-size: 1.9rem;
    }
  }
</style>
