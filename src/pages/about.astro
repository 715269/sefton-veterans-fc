---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  HONOURS as honours,
  ROLL_OF_HONOUR as rollOfHonour,
  AWARDS,
  FOUNDED,
  CLUBMAN_OF_DECADE,
} from '../lib/honours.js';
import { Image } from 'astro:assets';
import davidStafford from '../assets/david_stafford.jpg';
import phillipStafford from '../assets/phillip_stafford.jpg';

const decadePhotos = { 'david-stafford': davidStafford, 'phillip-stafford': phillipStafford };

const committee = [
  { role: 'Chairman', name: 'Geoff McKeating' },
  { role: 'Secretary/Treasurer', name: 'Gerard Kinsella' },
  { role: 'Over 35s Fixtures', name: 'Robbie Halpin' },
  { role: 'Over 45s & 50s Fixtures', name: 'Brian Gilligan' },
  { role: 'Social Secretary', name: 'Alan Roberts' },
  { role: 'Member', name: 'Fran Armstrong' },
  { role: 'Member', name: 'Chris Long' },
  { role: 'Member', name: 'Gary Brookes' },
];

// Kept separate from the committee rather than run together as one long grid:
// seventeen cards in a single block is a wall, and these are a different kind
// of role — matchday rather than club administration.
const teamRoles = [
  { role: 'Club Captain', name: 'Jay Shannon' },
  { role: 'Over 35s Manager', name: 'David Stafford' },
  { role: 'Over 35s Captain', name: 'Thomas King' },
  { role: 'Over 45s Manager', name: 'Gary McQueen' },
  { role: 'Over 50s Manager', name: 'Paul McKendrick' },
  { role: 'Open Age Manager', name: 'Tom Furnival' },
  { role: 'Open Age Manager', name: 'Antony Hathaway' },
  { role: 'Open Age Captain', name: 'John McGunigle' },
  { role: 'Open Age Treasurer', name: 'Ash Stott' },
];
---

<BaseLayout title="About">
  <section class="hero-band">
    <div class="container">
      <h1>About Sefton Veterans FC</h1>
      <p>Competitive friendly football in Sefton, Merseyside since 2011.</p>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Our History</h2>
    <p>
      Sefton Veterans FC was founded in {FOUNDED} by former long-standing
      players and members of Waterloo Grammar School Old Boys Football Club,
      who wanted to keep playing the way they always had. The idea was
      straightforward and it still holds: competitive friendly football for
      over 35s — properly contested games, played in the right spirit.
    </p>
    <p>
      From that start the club has grown into a stable, multi-cup-winning
      operation, attracting good players from across Merseyside — providing
      they fit the club's standards, on and off the pitch.
    </p>
    <p>
      A second veterans side followed in 2019, and the club now runs an Over
      45s and an Over 50s alongside the original Over 35s. The 45s and 50s play
      chiefly in the Friendship Masters Cup and the Friendship Legends Cup, with
      a full programme of friendlies across Merseyside, Wirral and Cheshire.
    </p>
    <p>
      In 2023/24 the club welcomed an association with an open age team playing
      under the name Sefton OA FC, who won the Liverpool Football League Cup in
      2025/26. That same season the Over 35s stepped up into the Cheshire &amp;
      Wirral Football League — the club's first venture into league football,
      and a measure of how far it has come from a handful of old boys wanting a
      game on a Saturday.
    </p>
  </section>

  <section class="section-padded container">
    <h2>Honours Board</h2>

    <div class="honours-grid">
      {honours.map((h) => (
        <article class="honour-trophy">
          <p class="trophy-count">
            <span class="trophy-num">{h.seasons.length}</span>
            <span class="trophy-times">{h.seasons.length === 1 ? 'win' : 'wins'}</span>
          </p>
          <h3>{h.competition}</h3>
          {h.team && <p class="trophy-team">{h.team}</p>}
          <ul class="trophy-seasons">
            {h.seasons.map((s) => <li>{s}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section class="section-padded container">
    <div class="decade-feature">
      <div class="decade-photos">
        {CLUBMAN_OF_DECADE.recipients.map((r) => (
          <Image
            src={decadePhotos[r.photo]}
            alt={`${r.name} playing for Sefton Veterans FC`}
            width={340}
            height={453}
          />
        ))}
      </div>
      <div class="decade-body">
        <p class="decade-eyebrow">Special Recognition</p>
        <h2>{CLUBMAN_OF_DECADE.title}</h2>
        <p class="decade-names">
          {CLUBMAN_OF_DECADE.recipients.map((r) => r.name).join(' & ')}
        </p>
        <p class="decade-blurb">{CLUBMAN_OF_DECADE.blurb}</p>
        <p class="decade-thanks">The club are very grateful for all that you have both done.</p>
      </div>
    </div>
  </section>

  <section id="roll-of-honour" class="section-padded container">
    <h2>Roll of Honour</h2>
    <p class="roll-intro">
      Season by season since 2011/12. Where two names share an award, the club
      was fielding more than one side that year.
    </p>

    <div class="roll-grid">
      {rollOfHonour.map((year, i) => (
        <article class={`roll-card${i === 0 ? ' is-current' : ''}`}>
          <h3 class="roll-season">{year.season}</h3>
          <dl class="roll-list">
            {AWARDS.map(([key, label]) => (
              <div class="roll-row">
                <dt>{label}</dt>
                <dd>
                  {year[key].map(([name, team, note]) => (
                    <span class="winner">
                      <span class="winner-name">{name}</span>
                      {team && <span class="team-tag">{team}</span>}
                      {note && <span class="winner-note">{note}</span>}
                    </span>
                  ))}
                </dd>
              </div>
            ))}

            {year.decadeAward && (
              <div class="roll-row roll-row-decade">
                <dt>{CLUBMAN_OF_DECADE.title}</dt>
                <dd>
                  {CLUBMAN_OF_DECADE.recipients.map((r) => (
                    <span class="winner">
                      <span class="winner-name">{r.name}</span>
                    </span>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <!-- Governance last, deliberately. A visitor scrolling this far is a
       prospective player or a sponsor checking the club is real — what the
       club has won matters more to them than who chairs the committee, so
       that goes first and this is reference material at the foot. -->
  <section class="section-navy section-padded">
    <div class="container">
      <h2>Committee</h2>
      <ul class="role-list">
        {committee.map((person) => (
          <li>
            <span class="role-name">{person.name}</span>
            <span class="role-tag">{person.role}</span>
          </li>
        ))}
      </ul>

      <h3 class="group-heading">Team Management</h3>
      <ul class="role-list">
        {teamRoles.map((person) => (
          <li>
            <span class="role-name">{person.name}</span>
            <span class="role-tag">{person.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  .group-heading {
    color: white;
    margin: 2.5rem 0 1rem;
    font-size: 1.35rem;
  }

  /* A dense list rather than a grid of cards. Seventeen cards sized for a
     photo and a paragraph, holding two lines of text each, was the single
     biggest use of space on the page — and the section a first-time visitor
     cares about least. This does the same job in a third of the height. */
  .role-list {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.15rem 1.5rem;
  }

  .role-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .role-name {
    color: white;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .role-tag {
    color: #94a3b8;
    font-size: 0.75rem;
    text-align: right;
    white-space: nowrap;
  }

  .honours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .honour-trophy {
    border: 1px solid #e2e8f0;
    border-top: 4px solid var(--color-blue);
    border-radius: 10px;
    padding: 1.25rem;
    background: white;
  }

  .trophy-count {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0 0 0.15rem;
  }

  .trophy-num {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-navy);
    letter-spacing: -0.03em;
  }

  .trophy-times {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .honour-trophy h3 {
    margin: 0 0 0.15rem;
    font-size: 1.1rem;
    color: var(--color-navy);
  }

  .trophy-team {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .trophy-seasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .trophy-seasons li {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-blue);
    background: #e0e7ff;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  /* A feature, not a card — this recognises decades of service, which is a
     different scale to a season's top scorer, so it gets more visual weight
     than anything in the grids around it. */
  .decade-feature {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--color-navy);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .decade-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .decade-photos img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
  }

  .decade-eyebrow {
    color: #93c5fd;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 0.5rem;
  }

  .decade-body h2 {
    color: white;
    margin: 0 0 0.4rem;
  }

  .decade-names {
    color: white;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    margin: 0 0 1rem;
  }

  .decade-blurb {
    color: #cbd5e1;
    margin: 0 0 0.75rem;
    max-width: 56ch;
  }

  .decade-thanks {
    color: white;
    font-weight: 600;
    font-style: italic;
    margin: 0;
    max-width: 56ch;
  }

  @media (max-width: 700px) {
    .decade-feature {
      grid-template-columns: 1fr;
      padding: 1.75rem;
    }
  }

  .roll-intro {
    color: #64748b;
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .roll-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }

  .roll-card {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.1rem 1.15rem 1.25rem;
    background: white;
  }

  /* The current season gets the club blue down its edge — one card marked,
     not a different colour scheme, so the archive still reads as one set. */
  .roll-card.is-current {
    border-left: 4px solid var(--color-blue);
    background: #f8fafc;
  }

  .roll-season {
    font-size: 1.15rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    color: var(--color-navy);
  }

  .roll-list {
    margin: 0;
  }

  .roll-row + .roll-row {
    margin-top: 0.75rem;
  }

  .roll-row dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 0.2rem;
  }

  .roll-row dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Not an annual award like the four above it, so it gets a rule and a
     touch of colour rather than blending in as a fifth ordinary category. */
  .roll-row-decade {
    margin-top: 1rem !important;
    padding-top: 0.75rem;
    border-top: 1px dashed #cbd5e1;
  }

  .roll-row-decade dt {
    color: var(--color-blue);
    font-weight: 600;
  }

  .winner {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .winner-name {
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.95rem;
  }

  .team-tag {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-blue);
    background: #e0e7ff;
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    white-space: nowrap;
  }

  .winner-note {
    font-size: 0.72rem;
    color: #64748b;
    font-style: italic;
  }
</style>
