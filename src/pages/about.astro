---

<BaseLayout title="About">
  <section class="hero-band">
    <div class="container">
      <h1>About Sefton Veterans FC</h1>
      <p>Competitive friendly football in Sefton, Merseyside since 2011.</p>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Our History</h2>
    <p>
      The majority of our original members are former long-standing players
      and members of Waterloo Grammar School Old Boys Football Club, who
      decided that in order to continue with the ethos of "competitive
      friendly football for Over 35s" there was a need to establish this
      progressive and forward-looking football club.
    </p>
    <p>
      The club has grown into a strong and stable multi-cup winning
      operation, attracting the best players from around Merseyside —
      providing they fit with the club's high standards, on and off the
      pitch.
    </p>
    <p>
      In 2019, SVFC added a +50 team, now known as the Over 45s, playing
      highly competitive games across Merseyside, Wirral and Cheshire. In
      2023/24 the club welcomed an association with an open age team,
      playing under the name Sefton OA FC. In 2025/26, the Over 35s entered
      the Cheshire &amp; Wirral Football League (CWFL).
    </p>
  </section>

  <section class="section-navy section-padded">
    <div class="container">
      <h2>Committee</h2>
      <div class="card-grid">
        {committee.map((person) => (
          <div class="card committee-card">
            <div class="card-body">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="group-heading">Team Management</h3>
      <div class="card-grid">
        {teamRoles.map((person) => (
          <div class="card committee-card">
            <div class="card-body">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Honours Board</h2>

    <div class="honours-grid">
      {honours.map((h) => (
        <article class="honour-trophy">
          <p class="trophy-count">
            <span class="trophy-num">{h.seasons.length}</span>
            <span class="trophy-times">{h.seasons.length === 1 ? 'win' : 'wins'}</span>
          </p>
          <h3>{h.competition}</h3>
          <ul class="trophy-seasons">
            {h.seasons.map((s) => <li>{s}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section class="section-padded container">
    <h2>Roll of Honour</h2>
    <p class="roll-intro">
      Season by season since 2011/12. Where two names share an award, the club
      was fielding more than one side that year.
    </p>

    <div class="roll-grid">
      {rollOfHonour.map((year, i) => (
        <article class={`roll-card${i === 0 ? ' is-current' : ''}`}>
          <h3 class="roll-season">{year.season}</h3>
          <dl class="roll-list">
            {AWARDS.map(([key, label]) => (
              <div class="roll-row">
                <dt>{label}</dt>
                <dd>
                  {year[key].map(([name, team, note]) => (
                    <span class="winner">
                      <span class="winner-name">{name}</span>
                      {team && <span class="team-tag">{team}</span>}
                      {note && <span class="winner-note">{note}</span>}
                    </span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  .group-heading {
    color: white;
    margin: 2.5rem 0 1rem;
    font-size: 1.35rem;
  }

  .committee-card {
    background: white;
  }

  .committee-card .card-body h3 {
    color: var(--color-navy);
    font-size: 1rem;
  }

  .committee-card .card-body p {
    color: var(--color-blue);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .honours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .honour-trophy {
    border: 1px solid #e2e8f0;
    border-top: 4px solid var(--color-blue);
    border-radius: 10px;
    padding: 1.25rem;
    background: white;
  }

  .trophy-count {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0 0 0.15rem;
  }

  .trophy-num {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-navy);
    letter-spacing: -0.03em;
  }

  .trophy-times {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .honour-trophy h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    color: var(--color-navy);
  }

  .trophy-seasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .trophy-seasons li {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-blue);
    background: #e0e7ff;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .roll-intro {
    color: #64748b;
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .roll-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }

  .roll-card {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.1rem 1.15rem 1.25rem;
    background: white;
  }

  /* The current season gets the club blue down its edge — one card marked,
     not a different colour scheme, so the archive still reads as one set. */
  .roll-card.is-current {
    border-left: 4px solid var(--color-blue);
    background: #f8fafc;
  }

  .roll-season {
    font-size: 1.15rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    color: var(--color-navy);
  }

  .roll-list {
    margin: 0;
  }

  .roll-row + .roll-row {
    margin-top: 0.75rem;
  }

  .roll-row dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 0.2rem;
  }

  .roll-row dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .winner {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .winner-name {
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.95rem;
  }

  .team-tag {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-blue);
    background: #e0e7ff;
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    white-space: nowrap;
  }

  .winner-note {
    font-size: 0.72rem;
    color: #64748b;
    font-style: italic;
  }
</style>
