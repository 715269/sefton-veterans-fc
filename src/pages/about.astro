---
import BaseLayout from '../layouts/BaseLayout.astro';

// Trophies, grouped by competition rather than listed by season. Six wins in
// one cup is the story; six separate rows of a table hides it.
const honours = [
  {
    competition: 'Friendship Cup',
    seasons: ['2018/19', '2019/20', '2020/21', '2021/22', '2023/24', '2024/25'],
  },
  {
    competition: 'Friendship Masters Cup',
