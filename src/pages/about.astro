    clubman: [['Jay Shannon']],
  },
  {
    season: '2013/14',
    scorer: [['Mannie Penzie']],
    players: [['Chris Long']],
    managers: [['Gerard Kinsella']],
    clubman: [['Joe Lundon']],
  },
  {
    season: '2012/13',
    scorer: [['Paul Jordan']],
    players: [['Jay Shannon']],
    managers: [['Wayne Robinson']],
    clubman: [['Gerard Kinsella']],
  },
  {
    season: '2011/12',
    scorer: [['Les Ash']],
    players: [['Chris McGunigle']],
    managers: [['Dave Scanlan']],
    clubman: [['Mark Williams']],
