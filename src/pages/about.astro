// Kept separate from the committee rather than run together as one long grid:
// seventeen cards in a single block is a wall, and these are a different kind
// of role — matchday rather than club administration.
const teamRoles = [
  { role: 'Club Captain', name: 'Jay Shannon' },
  { role: 'Over 35s Manager', name: 'David Stafford' },
  { role: 'Over 35s Captain', name: 'Thomas King' },
  { role: 'Over 45s Manager', name: 'Gary McQueen' },
  { role: 'Over 50s Manager', name: 'Paul McKendrick' },
  { role: 'Open Age Manager', name: 'Tom Furnival' },
  { role: 'Open Age Manager', name: 'Antony Hathaway' },
  { role: 'Open Age Captain', name: 'John McGunigle' },
  { role: 'Open Age Treasurer', name: 'Ash Stott' },
