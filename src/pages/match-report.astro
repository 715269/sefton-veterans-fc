  .mr-seg[aria-label^='Position'] {
    flex-basis: 100%;
    justify-content: space-between;
  }

  .mr-seg[aria-label^='Position'] button { flex: 1 1 0; padding: 0.3rem 0.4rem; }

  .mr-seg[aria-label^='Position'] button[data-position='GK'][aria-pressed='true'] {
    background: #0f766e;
