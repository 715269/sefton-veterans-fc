---
// src/pages/teams/index.astro
//
// The four team cards. Names, slugs and blurbs come from src/lib/teams.js so
// this page and /teams/[team].astro can never disagree about what a team is
// called or where it lives. Only the photographs are chosen here, because they
// have to be imported for Astro to optimise them.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { TEAMS } from '../../lib/teams.js';
import agmGame from '../../assets/agm-game-2024.jpg';
import squad2022 from '../../assets/squad-2022.jpg';
import squad2023 from '../../assets/squad-2023.jpg';

const photos = {
  'over-35s': agmGame,
  'over-45s': squad2022,
  'over-50s': squad2023,
  'open-age': agmGame,
};

const teams = TEAMS.map((t) => ({ ...t, image: photos[t.slug] ?? agmGame }));
---

<BaseLayout title="Teams">
  <section class="hero-band">
    <div class="container">
      <h1>Our Teams</h1>
      <p>Four squads, one club — competitive football for every age group.</p>
    </div>
  </section>

  <section class="section-padded container">
    <div class="card-grid">
      {teams.map((team) => (
        <a href={`/teams/${team.slug}`} class="card">
          <Image
            src={team.image}
            alt={`${team.name} team photo`}
            width={600}
            height={450}
          />
          <div class="card-body">
            <h3>{team.name}</h3>
            <p>{team.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  /* The source photos are 4:3, but the cards want a wider band. Astro resizes
     at the native ratio (600x450) and the crop happens here, because handing
     Astro a mismatched width/height squashes the picture instead of cropping. */
  .card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
</style>
