---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import agmGame from '../../assets/agm-game-2024.jpg';
import squad2022 from '../../assets/squad-2022.jpg';
import squad2023 from '../../assets/squad-2023.jpg';

const teams = [
  {
    slug: 'over-35s',
    name: 'Over 35s',
    blurb: 'Competing in the Cheshire & Wirral Football League Premier Division.',
    image: agmGame,
  },
  {
    slug: 'over-45s',
    name: 'Over 45s',
    blurb: 'Friendly and cup football across Merseyside, Wirral and Cheshire.',
    image: squad2022,
  },
  {
    slug: 'over-50s',
    name: 'Over 50s',
    blurb: 'Legends Cup and friendly fixtures for our most experienced squad.',
    image: squad2023,
  },
  {
    slug: 'open-age',
    name: 'Open Age',
    blurb: 'Playing as Sefton OA FC since the 2023/24 season.',
    image: agmGame,
  },
];
---

<BaseLayout title="Teams">
  <section class="hero-band">
    <div class="container">
      <h1>Our Teams</h1>
      <p>Four squads, one club — competitive football for every age group.</p>
    </div>
  </section>

  <section class="section-padded container">
    <div class="card-grid">
      {teams.map((team) => (
        <a href={`/teams/${team.slug}`} class="card">
          <Image
            src={team.image}
            alt={`${team.name} team photo`}
            width={600}
            height={450}
          />
          <div class="card-body">
            <h3>{team.name}</h3>
            <p>{team.blurb}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="note"><em>Individual team pages aren't built yet — these link out but are placeholders for now.</em></p>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  /* The source photos are 4:3, but the cards want a wider band. Astro resizes
     at the native ratio (600x450) and the crop happens here, because handing
     Astro a mismatched width/height squashes the picture instead of cropping. */
  .card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .note {
    color: #64748b;
    font-size: 0.9rem;
  }
</style>
