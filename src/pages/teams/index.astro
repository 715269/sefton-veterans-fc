---
// src/pages/teams/index.astro
//
// The four team tiles live in TeamTiles.astro, because the home page shows the
// same set. One definition, two pages.

import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamTiles from '../../components/TeamTiles.astro';
---

<BaseLayout title="Teams">
  <section class="hero-band">
    <div class="container">
      <h1>Our Teams</h1>
      <p>Four squads, one club — competitive football for every age group.</p>
    </div>
  </section>

  <section class="section-padded container">
    <TeamTiles />
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }
</style>
