---
// src/pages/teams/index.astro
//
// The four team cards. Names, slugs and blurbs come from src/lib/teams.js so
// this page and /teams/[team].astro can never disagree about what a team is
// called or where it lives. Only the photographs are chosen here, because they
// have to be imported for Astro to optimise them.
//
// Filenames are lowercase with hyphens on purpose. Windows treats 'Open Age.png'
// and 'open-age.png' as the same file; Netlify's Linux builder does not, so a
// capital or a space here builds fine locally and 404s live.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { TEAMS } from '../../lib/teams.js';
import over35s from '../../assets/over-35s.jpg';
import over50s from '../../assets/over-50s.jpg';
import openAge from '../../assets/open-age.png';
import squad2022 from '../../assets/squad-2022.jpg';
import agmGame from '../../assets/agm-game-2024.jpg';

// Over 45s keeps the 2022 photo until a newer one turns up. agmGame is the
// whole club rather than any one side, so it is only the last resort for a
// team added to teams.js before anyone has taken its picture.
const photos = {
  'over-35s': over35s,
  'over-45s': squad2022,
  'over-50s': over50s,
  'open-age': openAge,
};

const teams = TEAMS.map((t) => ({ ...t, image: photos[t.slug] ?? agmGame }));
---

<BaseLayout title="Teams">
  <section class="hero-band">
    <div class="container">
      <h1>Our Teams</h1>
      <p>Four squads, one club — competitive football for every age group.</p>
    </div>
  </section>

  <section class="section-padded container">
    <div class="card-grid">
      {teams.map((team) => (
        <a href={`/teams/${team.slug}`} class="card">
          <Image
            src={team.image}
            alt={`${team.name} team photo`}
            width={600}
            height={450}
          />
          <div class="card-body">
            <h3>{team.name}</h3>
            <p>{team.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  /* The source photos vary in shape, but the cards want a consistent band.
     Astro resizes at the ratio given above and the crop happens here, because
     handing Astro a mismatched width/height squashes the picture instead of
     cropping it. */
  .card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
</style>
