---
// src/pages/lps/how-to-play.astro
//
// Player-facing notes for Last Person Standing. Styled to match the rest
// of the site rather than the game itself — it's a content page.
//
// The entry fee is set once, below.

import BaseLayout from '../../layouts/BaseLayout.astro';

const ENTRY_FEE = '£10';
const PAY_TO = 'Alan Roberts';

const rules = [
  {
    lead: 'Pick one Premier League team to win.',
    body: 'Every gameweek, you back a single side.',
  },
  {
    lead: "They win, you're through.",
    body: "A draw knocks you out, same as a defeat. There's no half measure.",
  },
  {
    lead: "You can't pick the same team twice.",
    body: "Use Liverpool in week one and they're gone for the rest of the run. When all twenty have been used, everyone starts fresh.",
  },
  {
    lead: 'Picks lock at the first kick-off',
    body: "of the gameweek — usually the Friday night game. Miss it and you're given the next available team alphabetically, so you stay in but you don't get to choose.",
  },
  {
    lead: 'Last one standing takes the pot.',
    body: '',
  },
];
---

<BaseLayout title="How to Play — Last Person Standing">
  <section class="hero-band">
    <div class="container">
      <h1>How to Play</h1>
      <p>Last Person Standing. One team a week. One life.</p>
      <a href="/lps" class="hero-skip">Know the rules? Go straight to the game →</a>
    </div>
  </section>

  <section class="section-padded container">
    <h2>The game</h2>
    <ol class="rules">
      {rules.map((rule, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <div><strong>{rule.lead}</strong> {rule.body}</div>
        </li>
      ))}
    </ol>

    <div class="note note-warn">
      <h3>Miss the deadline and the game picks for you</h3>
      <p>
        You won't be knocked out for forgetting, but you'll be handed whichever
        team comes first alphabetically that you haven't already used — which
        might be anyone. You'll get a reminder email the day before. Put your
        own pick in and take the choice out of the computer's hands.
      </p>
    </div>
  </section>

  <section class="section-light section-padded">
    <div class="container">
      <h2>Entering</h2>
      <p>
        Go to the game, tap <strong>Register</strong>, and put in your name, your
        email address and a 4-digit PIN of your choosing. From then on you sign
        in with that email and PIN.
      </p>
      <p>
        Lost the PIN? Tap <strong>Forgotten your PIN?</strong> on the sign-in
        screen and it'll be emailed to you.
      </p>
      <p>
        Entering more than once, or sharing an address with someone? Use the same
        email and give each entry a different name — you'll be asked which entry
        is yours when you sign in.
      </p>

      <div class="note">
        <h3>Entry fee</h3>
        <p>
          <span class="fee">{ENTRY_FEE}</span> — <strong>pay {PAY_TO}</strong>.
        </p>
        <p>
          You're not in until you've paid. Cash or a transfer, same as anything
          else.
        </p>
      </div>

      <h2>Rollovers and buying in</h2>
      <p>
        If everyone still standing goes out in the same week, nobody is
        eliminated — the round is void and it becomes a <strong>rollover</strong>.
        Everyone still in puts another {ENTRY_FEE} in to carry on, and the pot
        grows.
      </p>
      <p>
        A rollover is also the moment to <strong>buy in</strong>. Anyone who's
        been knocked out can come back, and anyone who missed the start can join.
      </p>
      <p>
        The rule is simply that everyone in the pot has the same money in it. If
        you've been playing all along, you've already paid for the earlier rounds,
        so you just add your {ENTRY_FEE} like everyone else. If you're coming in
        at the third round, you pay {ENTRY_FEE} three times over to catch up with
        the players who've been paying since the start. Nobody buys into a big
        pot on the cheap, and nobody who's stuck with it pays twice for the same
        round.
      </p>
    </div>
  </section>

  <section class="section-padded container">
    <h2>Each week</h2>
    <ul class="plain">
      <li>Sign in, look at the fixtures, tap the team you fancy. That's it.</li>
      <li>Teams you've already used are crossed out, so you can't pick them by mistake.</li>
      <li>You can change your mind as often as you like until the deadline.</li>
      <li>The clock at the top counts down to the lock. It turns amber in the last two hours.</li>
      <li>Nobody can see anyone else's pick until the deadline passes. After that, the board shows the lot.</li>
    </ul>

    <h2>The odd situations</h2>
    <ul class="plain">
      <li>
        <strong>A match in the round gets postponed.</strong> The whole round is
        void. Nobody goes out, and everyone gets their team handed back.
      </li>
      <li>
        <strong>Everyone still in goes out in the same week.</strong> It's a
        rollover — nobody goes out, everyone gets their pick back, and we carry on.
      </li>
      <li>
        <strong>Something's gone wrong with your entry.</strong> Have a word with Ged.
      </li>
    </ul>

    <h2>A word of advice</h2>
    <p class="advice">
      The temptation is to take the biggest favourite every week. The trouble is
      everyone else does too, and you burn the good teams early. Plenty of people
      go out in November with nothing left but Burnley away at Anfield.
    </p>

    <div class="cta-band">
      <div>
        <h2>Ready?</h2>
        <p>Picks lock at the first kick-off of the gameweek.</p>
      </div>
      <a href="/lps" class="btn btn-primary">Go to the game</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: var(--color-navy);
    color: white;
    padding: 2.5rem 0;
  }

  .hero-band h1 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .hero-band p {
    color: #cbd5e1;
    margin: 0;
  }

  .hero-skip {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hero-skip:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .rules {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  .rules li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .rules li:last-child {
    border-bottom: 0;
  }

  .rules .num {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    font-weight: 600;
    color: #b45309;
    padding-top: 0.2rem;
  }

  .note {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 3px solid #f59e0b;
    border-radius: 0 10px 10px 0;
    padding: 1.1rem 1.3rem;
    margin: 1.5rem 0;
  }

  .note-warn {
    border-left-color: #b3323b;
  }

  .note h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: var(--color-navy);
  }

  .note p {
    margin: 0 0 0.5rem;
    color: #64748b;
  }

  .note p:last-child {
    margin-bottom: 0;
  }

  .fee {
    font-size: 1.3rem;
    font-weight: 700;
    color: #b45309;
  }

  ul.plain {
    padding-left: 1.1rem;
    margin: 0.75rem 0 1.5rem;
    color: #475569;
  }

  ul.plain li {
    margin-bottom: 0.55rem;
  }

  .advice {
    color: #64748b;
    max-width: 62ch;
  }

  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.75rem 2rem;
    margin-top: 2rem;
  }

  .cta-band h2 {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
  }

  .cta-band p {
    margin: 0;
    color: #64748b;
  }
</style>
